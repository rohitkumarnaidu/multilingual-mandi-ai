# Environment Configuration for Multilingual Mandi Platform

# Application Settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multilingual_mandi
DB_USER=postgres
DB_PASSWORD=password
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Settings
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI/ML Service Configuration
TRANSLATION_SERVICE_URL=http://localhost:8001
VOICE_SERVICE_URL=http://localhost:8002
PRICE_INTELLIGENCE_URL=http://localhost:8003
NEGOTIATION_SERVICE_URL=http://localhost:8004

# External API Keys (for production)
HUGGINGFACE_API_KEY=your-huggingface-api-key
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_API_URL=https://api.sarvam.ai/translate
OPENAI_API_KEY=your-openai-api-key
GOVERNMENT_API_KEY=your-government-api-key

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Cache Settings
CACHE_TTL_TRANSLATION=86400
CACHE_TTL_PRICE=14400
CACHE_TTL_SESSION=86400

# Monitoring and Logging
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true